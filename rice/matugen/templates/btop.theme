# rice-matugen: btop theme generated from the wallpaper.
# Select it with  color_theme = "rice"  in btop.conf (or Options > Color theme).

# Empty so the terminal background shows through.
theme[main_bg]=""
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.on_surface.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[selected_bg]="{{colors.secondary_container.default.hex}}"
theme[selected_fg]="{{colors.on_secondary_container.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"
theme[meter_bg]="{{colors.surface_container_highest.default.hex}}"
theme[proc_misc]="{{colors.tertiary.default.hex}}"

theme[cpu_box]="{{colors.primary.default.hex}}"
theme[mem_box]="{{colors.secondary.default.hex}}"
theme[net_box]="{{colors.tertiary.default.hex}}"
theme[proc_box]="{{colors.outline.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

theme[temp_start]="{{colors.secondary.default.hex}}"
theme[temp_mid]="{{colors.primary.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

theme[cpu_start]="{{colors.primary_fixed_dim.default.hex}}"
theme[cpu_mid]="{{colors.primary.default.hex}}"
theme[cpu_end]="{{colors.error.default.hex}}"

theme[free_start]="{{colors.secondary_container.default.hex}}"
theme[free_mid]=""
theme[free_end]="{{colors.secondary.default.hex}}"

theme[cached_start]="{{colors.tertiary_container.default.hex}}"
theme[cached_mid]=""
theme[cached_end]="{{colors.tertiary.default.hex}}"

theme[available_start]="{{colors.primary_container.default.hex}}"
theme[available_mid]=""
theme[available_end]="{{colors.primary.default.hex}}"

theme[used_start]="{{colors.error_container.default.hex}}"
theme[used_mid]=""
theme[used_end]="{{colors.error.default.hex}}"

theme[download_start]="{{colors.secondary_container.default.hex}}"
theme[download_mid]="{{colors.secondary.default.hex}}"
theme[download_end]="{{colors.primary.default.hex}}"

theme[upload_start]="{{colors.tertiary_container.default.hex}}"
theme[upload_mid]="{{colors.tertiary.default.hex}}"
theme[upload_end]="{{colors.primary.default.hex}}"

theme[process_start]="{{colors.primary.default.hex}}"
theme[process_mid]="{{colors.tertiary.default.hex}}"
theme[process_end]="{{colors.error.default.hex}}"
